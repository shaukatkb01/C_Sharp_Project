@model System.Data.DataTable

@{
    ViewData["Title"] = "Indents";
}

<h2>Indents</h2>

<table id="indents" class="display">
    <thead>
        <tr>
            <th>IndentID</th>
            <th>IndentNo</th>
            <th>IndentDate</th>
            <th>OfficeName</th>
            <th>TotalItems</th>
            <th>Remarks</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (System.Data.DataRow row in Model.Rows)
    {
        <tr>
            <td>@row["IndentID"]</td>
            <td>@row["IndentNo"]</td>
            <td>@(row["IndentDate"] == DBNull.Value ? "" : ((DateTime)row["IndentDate"]).ToString("yyyy-MM-dd"))</td>
            <td>@row["OfficeName"]</td>
            <td>@row["TotalItems"]</td>
            <td>@row["Remarks"]</td>
            <td><a asp-action="Details" asp-route-id="@row["IndentID"]">Details</a></td>
        </tr>
    }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('#indents').DataTable();
    });
</script>
