<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SupplyBranch</title>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <nav id="mainNavbarEl" class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <span class="me-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16">
                            <path d="M.05 3.555A2 2 0 0 1 2.002 2h11.996a2 2 0 0 1 1.953 1.555L8 8.414.05 3.555z"/>
                            <path d="M0 4.697v7.104l5.803-3.552L0 4.697zM6.761 8.83 16 12.498V4.697l-9.239 4.133z"/>
                        </svg>
                    </span>
                    <span>Postal Stamp Branch Management System</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <div class="ms-2 me-auto">
                        <button id="themeToggle" class="btn btn-sm btn-outline-light" type="button" title="Toggle theme">Toggle Theme</button>
                    </div>
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" href="/">Dashboard</a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="supplyDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Supply</a>
                                <ul class="dropdown-menu" aria-labelledby="supplyDropdown">
                                    <li><a class="dropdown-item" href="/Supply/Create">Create Supply</a></li>
                                    <li><a class="dropdown-item" href="/Supply">Supply List</a></li>
                                    <li><a class="dropdown-item" href="/Supply/Drafts">Drafts</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="indentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Indent</a>
                                <ul class="dropdown-menu" aria-labelledby="indentDropdown">
                                    <li><a class="dropdown-item" href="/Indent/Create">Create Indent</a></li>
                                    <li><a class="dropdown-item" href="/Indent">Indent List</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="masterDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Master Data / Reports</a>
                                <ul class="dropdown-menu" aria-labelledby="masterDropdown">
                                    <li><a class="dropdown-item" href="/Office">Offices</a></li>
                                    <li><a class="dropdown-item" href="/Stock">Stock / Ledger</a></li>
                                    <li><a class="dropdown-item" href="/Reports">Reports</a></li>
                                </ul>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="me-2">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" href="/Account/Profile">Profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" action="/Account/Logout" class="px-3 py-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger w-100">Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link btn btn-light text-primary ms-2" href="/Account/Login">Login</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">

        @* TempData alerts *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer>
        <hr />
        <p>&copy; SupplyBranch</p>
    </footer>
    <!-- Scripts: jQuery, DataTables, Bootstrap bundle, site script -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>

    <script>
        (function(){
            const toggle = document.getElementById('themeToggle');
            const navbar = document.getElementById('mainNavbarEl');
            const body = document.body;

            function applyTheme(theme){
                if(!navbar) return;
                if(theme === 'light'){
                    navbar.classList.remove('navbar-dark','bg-dark');
                    navbar.classList.add('navbar-light','bg-light');
                    body.classList.remove('bg-dark','text-white');
                    body.classList.add('bg-light','text-dark');
                    if(toggle) toggle.classList.remove('btn-outline-light');
                    if(toggle) toggle.classList.add('btn-outline-dark');
                } else {
                    navbar.classList.remove('navbar-light','bg-light');
                    navbar.classList.add('navbar-dark','bg-dark');
                    body.classList.remove('bg-light','text-dark');
                    body.classList.add('bg-dark','text-white');
                    if(toggle) toggle.classList.remove('btn-outline-dark');
                    if(toggle) toggle.classList.add('btn-outline-light');
                }
            }

            // Initialize theme
            const saved = localStorage.getItem('site-theme') || 'dark';
            applyTheme(saved);

            if(toggle){
                toggle.addEventListener('click', function(){
                    const current = localStorage.getItem('site-theme') || 'dark';
                    const next = current === 'dark' ? 'light' : 'dark';
                    localStorage.setItem('site-theme', next);
                    applyTheme(next);
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
