                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>                          The following Postal Stamps (Public &amp; Service Postage Stamps and Stationery) have been despatched to your office under this office despatch Note </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>11pt</FontSize>
