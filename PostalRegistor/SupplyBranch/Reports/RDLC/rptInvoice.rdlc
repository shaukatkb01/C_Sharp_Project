  <Code>
    Public Function FormatReportDate(value As Object) As String
    If value Is Nothing OrElse Convert.IsDBNull(value) Then
    Return ""
    End If

    Dim result As DateTime

    If DateTime.TryParse(value.ToString(), result) Then
    Return result.ToString("dd-MM-yyyy")
    End If

    Return ""
    End Function


    Public Function FormatAmountScale(amount As Object) As String

    If amount Is Nothing OrElse IsDBNull(amount) Then
    Return "Zero Only"
    End If

    Dim valDec As Decimal

    If Not Decimal.TryParse(amount.ToString(), valDec) Then
    Return "Zero Only"
    End If

    If valDec &lt; 0 Then
    Return "Minus " &amp; NumberToWords(Math.Abs(valDec)) &amp; " Only"
    End If

    Return NumberToWords(valDec) &amp; " Only"

    End Function

    Private Function NumberToWords(ByVal amount As Decimal) As String

    If amount = 0 Then Return "Zero"

    Dim whole As Long = CLng(Math.Floor(amount))
    Dim words As String = ConvertWholeNumber(whole)

    Dim paisa As Integer = CInt(Math.Round((amount - whole) * 100))

    If paisa &gt; 0 Then
    words &amp;= " and " &amp; ConvertWholeNumber(paisa) &amp; " Paisa"
    End If

    Return words

    End Function

    Private Function ConvertWholeNumber(ByVal number As Long) As String

    Dim ones() As String = {
    "", "One", "Two", "Three", "Four", "Five",
    "Six", "Seven", "Eight", "Nine", "Ten",
    "Eleven", "Twelve", "Thirteen", "Fourteen",
    "Fifteen", "Sixteen", "Seventeen", "Eighteen",
    "Nineteen"
    }

    Dim tens() As String = {
    "", "", "Twenty", "Thirty", "Forty",
    "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
    }

    If number &lt; 20 Then Return ones(CInt(number))

    If number &lt; 100 Then
    Return tens(CInt(number \ 10)) &amp;
    If(number Mod 10 &gt; 0, " " &amp; ones(CInt(number Mod 10)), "")
    End If

    If number &lt; 1000 Then
    Return ones(CInt(number \ 100)) &amp; " Hundred" &amp;
    If(number Mod 100 &gt; 0,
    " " &amp; ConvertWholeNumber(number Mod 100), "")
    End If

    If number &lt; 1000000 Then
    Return ConvertWholeNumber(number \ 1000) &amp; " Thousand" &amp;
    If(number Mod 1000 &gt; 0,
    " " &amp; ConvertWholeNumber(number Mod 1000), "")
    End If

    If number &lt; 1000000000 Then
    Return ConvertWholeNumber(number \ 1000000) &amp; " Million" &amp;
    If(number Mod 1000000 &gt; 0,
    " " &amp; ConvertWholeNumber(number Mod 1000000), "")
    End If

    Return ConvertWholeNumber(number \ 1000000000) &amp; " Billion" &amp;
    If(number Mod 1000000000 &gt; 0,
    " " &amp; ConvertWholeNumber(number Mod 1000000000), "")

    End Function
  </Code>
