      <ReportItems>
        <Textbox Name="Textbox42">
          <CanGrow>true</CanGrow>
          <KeepTogether>true</KeepTogether>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>Note:- The copies of this invoice are to be disposed of as follows:-</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>(a) The ORIGINAL to be retained in the local or branch depot as the case may be.</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>(b) The DUPLICATE to be acknowledged and returned to the Chief Controller of Stamps.</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>Karachi ordinary not later than seven days and in special cases not later than fifteen days after </Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>the receipt of the consignment of stamps.</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>(c) The Director of Accounts, Pakistan Post Office Department, Lahore</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontSize>11pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <TextDecoration>None</TextDecoration>
                    <Color>#000000</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
