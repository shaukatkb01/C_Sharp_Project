                        <Textbox Name="Textbox37">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Advises despatch of </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=IIF(
    LCase(Trim(CStr(Fields!PackingType.Value &amp; ""))) = "other",
    IIF(
        IsNothing(Fields!OtherPackingType.Value) Or
        Trim(CStr(Fields!OtherPackingType.Value &amp; "")) = "",
        "Other",
        Trim(CStr(Fields!OtherPackingType.Value &amp; ""))
    ),
    Format(Val(Fields!PackingQty.Value &amp; ""), "00") &amp; "  " &amp;
    IIF(
        LCase(Trim(CStr(Fields!PackingType.Value &amp; ""))) = "case",
        "Box(es)",
        Trim(CStr(Fields!PackingType.Value &amp; ""))
    )
)</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
